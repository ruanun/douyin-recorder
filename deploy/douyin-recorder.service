[Unit]
Description=Douyin live stream & danmaku recorder (headless web service)
Documentation=https://github.com/SplashedWhite/douyin-recorder
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Runs as the unprivileged user that owns /var/lib/douyin-recorder.
User=douyin-recorder
Group=douyin-recorder
ExecStart=/usr/local/bin/douyin-recorder-server
Environment=DOUYIN_RECORDER_HOME=/var/lib/douyin-recorder
Environment=DOUYIN_RECORDER_BIND=127.0.0.1:8787
# Put the access token in this file (chmod 600) instead of the unit file.
EnvironmentFile=-/etc/douyin-recorder.env
Restart=on-failure
RestartSec=5s
# Graceful shutdown: SIGTERM lets the recorder flush the current file.
KillSignal=SIGTERM
TimeoutStopSec=120

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/douyin-recorder
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
